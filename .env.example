# Render automatically sets PORT
PORT=8080

# The public URL of this service for self-keep-alive
SELF_URL=https://your-service-name.onrender.com/health

# Request timeout for the keep-alive pings
REQUEST_TIMEOUT=15

# Pyronites backend (required for persistence)
PYRONITES_URL=https://your-pyronites-backend.onrender.com
PYRONITES_KEY=pyro_live_your_api_key_here
